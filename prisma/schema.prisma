generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  REVIEWER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  emailVerified DateTime?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  reviewDecisions ReviewDecision[]
  unlockEvents    UnlockEvent[]
  auditLogs       AuditLog[]
  agentRuns       AgentRun[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  prompts Prompt[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  prompts PromptTag[]

  @@map("tags")
}

model PromptTag {
  promptId String
  tagId    String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@map("prompt_tags")
}

enum PromptStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_CHANGES
  PUBLISHED
  ARCHIVED
}

enum PromptType {
  TEXT
  CODE
  SYSTEM_PROMPT
  CHAIN
  IMAGE
}

model Prompt {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @db.Text
  type        PromptType   @default(TEXT)
  status      PromptStatus @default(DRAFT)
  categoryId  String
  content     String       @db.Text
  thumbnailUrl String?     @db.Text
  metadata    Json?
  unlockCount Int          @default(0)
  viewCount   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  category     Category         @relation(fields: [categoryId], references: [id])
  tags         PromptTag[]
  versions     PromptVersion[]
  previews     PromptPreview[]
  drafts       PromptDraft[]
  reviews      ReviewDecision[]
  unlockEvents UnlockEvent[]
  auditLogs    AuditLog[]

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([publishedAt])
  @@map("prompts")
}

model PromptVersion {
  id        String   @id @default(cuid())
  promptId  String
  version   Int
  content   String   @db.Text
  metadata  Json?
  changelog String?  @db.Text
  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@map("prompt_versions")
}

model PromptPreview {
  id        String   @id @default(cuid())
  promptId  String
  type      String
  content   String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@map("prompt_previews")
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model PromptDraft {
  id          String     @id @default(cuid())
  promptId    String?
  agentRunId  String
  title       String
  description String     @db.Text
  content     String     @db.Text
  type        PromptType @default(TEXT)
  metadata    Json?
  createdAt   DateTime   @default(now())

  prompt   Prompt?  @relation(fields: [promptId], references: [id])
  agentRun AgentRun @relation(fields: [agentRunId], references: [id])

  @@map("prompt_drafts")
}

model AgentRun {
  id          String         @id @default(cuid())
  initiatedBy String?
  skill       String
  input       Json
  output      Json?
  status      AgentRunStatus @default(QUEUED)
  error       String?        @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  initiator User?        @relation(fields: [initiatedBy], references: [id])
  drafts    PromptDraft[]

  @@index([status])
  @@index([createdAt])
  @@map("agent_runs")
}

enum ReviewAction {
  APPROVED
  REJECTED
  NEEDS_CHANGES
  ESCALATED
}

model ReviewDecision {
  id         String       @id @default(cuid())
  promptId   String
  reviewerId String
  action     ReviewAction
  notes      String?      @db.Text
  createdAt  DateTime     @default(now())

  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  reviewer User   @relation(fields: [reviewerId], references: [id])

  @@index([promptId])
  @@index([reviewerId])
  @@map("review_decisions")
}

model UnlockEvent {
  id        String   @id @default(cuid())
  promptId  String
  userId    String?
  method    String
  ipHash    String?
  createdAt DateTime @default(now())

  prompt  Prompt  @relation(fields: [promptId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  adEvent AdEvent?

  @@index([promptId])
  @@index([userId])
  @@map("unlock_events")
}

model AdEvent {
  id            String   @id @default(cuid())
  unlockEventId String   @unique
  provider      String
  adUnitId      String?
  impressionId  String?
  completed     Boolean  @default(false)
  revenue       Decimal? @db.Decimal(10, 4)
  metadata      Json?
  createdAt     DateTime @default(now())

  unlockEvent UnlockEvent @relation(fields: [unlockEventId], references: [id])

  @@map("ad_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  promptId  String?
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  prompt Prompt? @relation(fields: [promptId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@index([promptId])
  @@map("audit_logs")
}
