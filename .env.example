# =============================================================================
# Softset - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables marked (optional) have sensible defaults or are not needed for
# basic local development.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://prompt_user:prompt_pass@localhost:5432/prompt_platform?schema=public"

# -----------------------------------------------------------------------------
# Authentication (NextAuth)
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Service Providers
# -----------------------------------------------------------------------------
# Ad provider: "mock" | "google" (default: mock)
AD_PROVIDER="mock"

# File storage: "local" | "s3" (default: local)
STORAGE_PROVIDER="local"

# AI provider: "mock" | "openai" | "anthropic" (default: mock)
AI_PROVIDER="mock"

# -----------------------------------------------------------------------------
# AI API Keys (optional - only needed if AI_PROVIDER is not "mock")
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# S3 Storage (optional - only needed if STORAGE_PROVIDER is "s3")
# -----------------------------------------------------------------------------
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""  # For S3-compatible services like MinIO

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
